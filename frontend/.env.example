# FloodLens AI — Frontend Environment Variables
# Only PUBLIC configuration goes here. Never put secrets in VITE_ variables.
#
# VITE_API_BASE_URL: The backend API Gateway URL
# - Local development: leave empty (vite.config.ts proxies /api and /health to localhost:8000)
# - Production (Amplify): set to your deployed API Gateway HTTPS URL
#
# === LOCAL DEVELOPMENT ===
# Leave VITE_API_BASE_URL empty. Vite dev server proxies requests to the local backend.
VITE_API_BASE_URL=
#
# === PRODUCTION (AWS Amplify Hosting) ===
# Set this in Amplify environment variables to your API Gateway URL.
# Example:
# VITE_API_BASE_URL=https://abc123.execute-api.us-east-1.amazonaws.com/prod
#
# Do NOT put any of the following in VITE_ variables:
# - MODEL_API_KEY
# - DATABASE_URL
# - AWS secret keys
# - Private inference endpoint keys
