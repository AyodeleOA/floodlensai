# FloodLens AI — Backend Environment Variables
# Copy this file to .env and fill in values. Never commit real secrets to Git.
# For production, store secrets in AWS Secrets Manager, not in this file.

# === Core App ===
APP_ENV=local
APP_NAME=FloodLens AI
API_V1_PREFIX=/api/v1

FRONTEND_ORIGIN=http://localhost:5173

# === Database ===
# Local dev: local PostgreSQL with PostGIS
# Production: RDS PostgreSQL with PostGIS (store credentials in Secrets Manager)
DATABASE_URL=postgresql+psycopg://floodlens:floodlens@localhost:5432/floodlens

# === S3 / AWS ===
# Production: the S3 bucket name for media uploads
S3_MEDIA_BUCKET=
AWS_REGION=us-east-1
# For local dev with LocalStack, set to http://localhost:4566
AWS_ENDPOINT_URL=

# === Meta Model API ===
# Store in Secrets Manager for production. Never expose to the frontend.
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_WONDER_MODEL=muse-wonder-1.0
MUSE_IMAGE_MODEL=muse-image-1.0
MUSE_VOICE_MODEL=muse-voice-transcribe-1.0
SAM_MODEL=sam-3.1

# === Open-Weight Adapters ===
# Muse Glimmer (local/edge OpenAI-compatible endpoint)
MUSE_GLIMMER_ENABLED=false
MUSE_GLIMMER_BASE_URL=
MUSE_GLIMMER_MODEL=
MUSE_GLIMMER_API_KEY=
# Muse Spark Open (private GPU endpoint)
MUSE_SPARK_OPEN_ENABLED=false
MUSE_SPARK_OPEN_BASE_URL=
MUSE_SPARK_OPEN_MODEL=
MUSE_SPARK_OPEN_API_KEY=

# === AI Feature Flags ===
# Set AI_PROVIDER_MODE=live and enable features for production AI
# mock = demo fixtures only, demo = demo mode, live = real Meta API calls
AI_PROVIDER_MODE=live
ENABLE_AI_IMAGE_ANALYSIS=true
ENABLE_AI_VOICE_TRANSCRIPTION=true
ENABLE_SAM_SEGMENTATION=true
ENABLE_MUSE_IMAGE_GENERATION=true
ENABLE_MUSE_WONDER_ANALYST=true

# === SQS ===
# Production: set to your deployed SQS queue URLs
SQS_MEDIA_ANALYSIS_QUEUE_URL=
SQS_MEDIA_ANALYSIS_DLQ_URL=

# === Cognito ===
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# === Risk Engine ===
RISK_WEIGHTS_PROFILE=illustrative_unvalidated
RISK_GRID_SYSTEM=h3
RISK_GRID_RESOLUTION=8

# === Demo Mode ===
# Set to false for production
DEMO_MODE=false
